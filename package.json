{
	"name": "naveti-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.13.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"clean": "pnpm -r run clean",
		"build": "pnpm -r --filter \"./packages/kernel/*\" run build",
		"build:catalog": "pnpm --filter @naveti/ai run build:catalog",
		"check": "node scripts/biome-check.mjs --write && pnpm run check:pinned-deps && pnpm run check:runtime-deps && pnpm run check:ts-imports && pnpm run check:entry-graphs && pnpm run check:workspace-resolution && pnpm run check:lockfile-commit && pnpm run check:test-integrity && pnpm run check:doc-links && pnpm run test:scripts && tsc --noEmit",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:runtime-deps": "node scripts/check-runtime-deps.mjs",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"check:entry-graphs": "node scripts/check-entry-graphs.mjs",
		"check:workspace-resolution": "node scripts/check-workspace-resolution.mjs",
		"check:lockfile-commit": "node scripts/check-lockfile-commit.mjs",
		"check:test-integrity": "node scripts/check-test-integrity.mjs",
		"test-integrity:write": "node scripts/check-test-integrity.mjs --write",
		"test": "pnpm -r --if-present run test",
		"test:scripts": "node --test scripts/*.test.mjs scripts/*.test.ts",
		"test:ci": "node scripts/run-tests.mjs --projects --hermetic",
		"test:ci:local": "node scripts/run-tests.mjs --projects",
		"hooks:install": "node scripts/install-hooks.mjs",
		"rename:scope": "node scripts/rename-scope.mjs",
		"check:doc-links": "node scripts/check-doc-links.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@biomejs/wasm-nodejs": "2.3.5",
		"@naveti/ai": "workspace:*",
		"@naveti/chord": "workspace:*",
		"@naveti/durable": "workspace:*",
		"@types/node": "22.19.19",
		"shx": "0.3.4",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
