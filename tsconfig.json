{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"customConditions": ["source"]
	},
	"include": [
		"scripts/model-catalog-protocol.ts",
		"scripts/model-catalog-protocol.test.ts",
		"packages/*/*/src/**/*",
		"packages/*/*/test/**/*",
		"packages/kernel/ai/catalog/**/*",
		"packages/kernel/durable/test-workers/**/*"
	],
	"exclude": ["**/dist/**"]
}
