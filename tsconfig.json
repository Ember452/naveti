{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"customConditions": ["source"]
	},
	"include": [
		"scripts/model-catalog-protocol.ts",
		"scripts/model-catalog-protocol.test.ts",
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/*/*/src/**/*",
		"packages/*/*/test/**/*",
		"apps/*/src/**/*",
		"apps/*/test/**/*",
		"packages/kernel/ai/catalog/**/*",
		"packages/kernel/durable/test-workers/**/*"
	],
	"exclude": [
		"**/dist/**",
		"packages/platform/web/**",
		"packages/features/*/src/client/**",
		"packages/features/*/test/**/*.tsx",
		"apps/web/**"
	]
}
